# Normalde .env install wizard (/install) tarafından otomatik yazılır.
# Elle kurulum için referans:

# --- Site ---
SITE_NAME=Kripto Lisans Paneli
SITE_DESC=Yazılım ve dijital ürün lisanslarını Ethereum NFT olarak üret, sat, devret ve doğrula.
APP_URL=http://localhost:8080
# 0 = production (no stack traces). Raise to 3 only for local debugging.
DEBUG=0

# --- Database (sqlite | mysql) ---
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cripto_lisans
DB_USER=root
DB_PASS=

# --- Chain (default Sepolia; mainnet = 1 + mainnet RPC) ---
CHAIN_ID=11155111
RPC_URL=
CONTRACT=
EIP712_NAME=LicensePanel
EIP712_VERSION=1

# Admin cüzdan(lar)ı (küçük harf, virgülle). Wizard MetaMask'tan otomatik doldurur.
ADMIN_ADDRESSES=

# Opsiyonel: server-side voucher signer (self-serve mağaza oto-issue için).
# Sadece mint yetkilendirir; on-chain SIGNER_ROLE'a sahip olmalı. Boş = admin elle imzalar.
SIGNER_KEY=

# Opsiyonel: fiat ödeme (Stripe) — faz-sonrası
STRIPE_SECRET=
STRIPE_PUBLIC=

# --- SMTP / e-posta (PHPMailer) — admin panelinden de düzenlenebilir ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=
SMTP_FROM_NAME=Kripto Lisans Paneli
